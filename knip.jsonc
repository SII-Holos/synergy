// Explicit test-runner devDependencies are invoked through Bun package scripts.
// Server retains hono-openapi runtime peers that its vendor code imports dynamically.
// dependency-cruiser is invoked with Bun forced as the runtime in deps:check.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "dist/**",
    ".turbo/**",
    ".synergy/**",
    "node_modules/**",
    "coverage/**",
    "research/**",
    "awcp-paper/**",
    "holos-paper/**",
    "packages/**/dist/**",
    "packages/**/release/**",
    "packages/sdk/js/src/gen/**",
    "apps/**/dist/**",
    "apps/**/release/**",
    "apps/web/test/**/.*-fixture-*/**",
    "packages/ui/test/**/.*-fixture-*/**",
  ],
  "ignoreDependencies": [
    "@babel/preset-typescript",
    "@ericsanchezok/synergy-plugin",
    "@ericsanchezok/synergy-sdk",
    "@scope/plugin",
    "playwright",
    "@sii-holos/holos-cli",
    "@shikijs/themes",
    "@shikijs/transformers",
    "@solid-primitives/bounds",
    "@solid-primitives/scroll",
    "@solid-primitives/websocket",
    "@tiptap/extension-floating-menu",
    "cropperjs",
    "diff",
    "fuzzysort",
    "katex",
    "marked",
    "marked-shiki",
    "solid-list",
    "solid-tiptap",
    "tailwindcss",
    "virtua",
    "electron-builder-squirrel-windows",
    "tree-sitter-bash",
    "turbo",
    "@tsconfig/bun",
    "@tsconfig/node22",
    "vite-plugin-icons-spritesheet",
    "@tailwindcss/vite",
    "@ast-grep/cli-darwin-arm64",
    "@ast-grep/cli-darwin-x64",
    "@ast-grep/cli-linux-arm64-gnu",
    "@ast-grep/cli-linux-x64-gnu",
    "@ast-grep/cli-win32-x64-msvc",
    "@parcel/watcher-darwin-arm64",
    "@parcel/watcher-darwin-x64",
    "@parcel/watcher-linux-arm64-glibc",
    "@parcel/watcher-linux-arm64-musl",
    "@parcel/watcher-linux-x64-glibc",
    "@parcel/watcher-linux-x64-musl",
    "@parcel/watcher-win32-arm64",
    "@parcel/watcher-win32-x64",
    "sqlite-vec-darwin-arm64",
    "sqlite-vec-darwin-x64",
    "sqlite-vec-linux-arm64",
    "sqlite-vec-linux-x64",
    "sqlite-vec-windows-x64",
  ],
  "ignoreBinaries": [
    // Oryn entrypoints resolve inside the separately pinned .oryn-runtime checkout.
    "script/run-workflow.ts",
    "script/plan-workflow.ts",
    "script/admit-workflow.ts",
    "src/cli.ts",
    "swiftc",
    "codesign",
    "hdiutil",
    "sips",
    "iconutil",
    "taskkill",
    "taskkill.exe",
    "which",
    "gh",
    "dev",
    "synergy",
    "build",
    "brew",
    "install",
    "run",
    "mix",
    "xcrun",
    "java",
    "powershell",
    "ps",
    "mode",
    "start",
    "stop",
    "latest",
    "gitleaks",
    "uvx",
    "uv",
    "rg",
    "linux",
    "windows",
    "cat-file",
    "rev-parse",
    "pkg",
    "HEAD",
    "generate",
  ],
  "ignoreUnresolved": [".json", ".svg"],
  "rules": {
    "catalog": "off",
  },
  "workspaces": {
    "benchmark": {
      "entry": [
        "runtime/entry.ts",
        "runtime/trial.ts",
        "runtime/prepare.ts",
        "runtime/worker.ts",
        "runtime/inspect.ts",
        "runtime/compositions/*.ts",
        "test/**/*.ts",
      ],
      "project": ["runtime/**/*.ts", "test/**/*.ts"],
    },
    "packages/ui": {
      "entry": [
        "src/components/**/*.{ts,tsx}",
        "src/context/**/*.{ts,tsx}",
        "src/hooks/**/*.ts",
        "src/plugin/**/*.ts",
        "src/pierre/**/*.ts",
        "src/theme/**/*.ts",
        "script/**/*.ts",
        "test/**/*.ts",
      ],
      "project": ["src/**/*.{ts,tsx}", "script/**/*.ts", "test/**/*.ts"],
    },
    "packages/sdk/js": {
      "entry": ["script/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts"],
    },
    "packages/plugin": {
      "project": ["src/**/*.ts"],
    },
    "packages/plugin-kit": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/util": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/harness": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/runtime-local": {
      "entry": ["script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
    },
    "packages/cli": {
      "entry": ["bin/synergy", "script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
    },
    "packages/server": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@hono/standard-validator", "zod-openapi"],
    },
    "packages/product-runtime": {
      "entry": ["script/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
    },
    "packages/browser-runtime": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/computer-runtime": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing", "@hono/standard-validator"],
    },
    "packages/library": {
      "entry": ["script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/note": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/workflows": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/connections": {
      "entry": ["script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/workbench": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/agent-integrations": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/media": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/plugin-host": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@ericsanchezok/synergy-testing"],
    },
    "packages/testing": {
      "entry": ["script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
    },
    "apps/web": {
      "entry": ["lingui.config.ts", "src/**/*.{ts,tsx}", "script/**/*.ts", "test/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "script/**/*.ts", "test/**/*.{ts,tsx}"],
    },
    "apps/desktop": {
      "entry": ["script/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "script/**/*.ts", "test/**/*.ts"],
    },
    ".": {
      "ignoreDependencies": ["dependency-cruiser"],
    },
  },
}
