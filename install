#!/usr/bin/env bash
set -euo pipefail
APP=synergy

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color
CHECKSUM_ASSET_NOT_FOUND=4

usage() {
    cat <<EOF
Synergy Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 2.4.3)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://raw.githubusercontent.com/SII-Holos/synergy/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/SII-Holos/synergy/main/install | bash -s -- --version 2.4.3
    ./install --binary /path/to/synergy
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

ROOT_DIR=$HOME/.synergy
INSTALL_DIR=$ROOT_DIR/bin
mkdir -p "$INSTALL_DIR"

has_bundled_assets_at() {
    local root="$1"
    [ -f "$root/app/index.html" ] && \
    [ -f "$root/schema/config.schema.json" ] && \
    [ -f "$root/browser-runtime/playwright-core/package.json" ] && \
    [ -f "$root/browser-runtime/playwright-core/index.js" ] && \
    [ -f "$root/browser-runtime/playwright-core/lib/coreBundle.js" ] && \
    [ -f "$root/lib/onnxruntime-web/ort-wasm-simd-threaded.asyncify.mjs" ] && \
    [ -f "$root/lib/onnxruntime-web/ort-wasm-simd-threaded.asyncify.wasm" ] && \
    [ -f "$root/lib/resvg-wasm/index_bg.wasm" ] && \
    [ -f "$root/lib/resvg-wasm/LICENSE-MPL-2.0.txt" ] && \
    [ -f "$root/lib/resvg-wasm/THIRD_PARTY_NOTICES.txt" ] && \
    [ -f "$root/lib/resvg-wasm/fonts/LICENSE-OFL-1.1.txt" ] && \
    [ -f "$root/lib/resvg-wasm/fonts/noto-sans-sc-chinese-simplified-400-normal.woff2" ] && \
    [ -f "$root/lib/resvg-wasm/fonts/noto-sans-sc-latin-400-normal.woff2" ] && \
    [ -f "$root/lib/holos-cli/index.js" ]
}

has_legacy_bundled_assets_at() {
    local root="$1"
    [ -f "$root/app/index.html" ] && \
    [ -f "$root/schema/config.schema.json" ] && \
    [ -f "$root/browser-runtime/playwright-core/package.json" ] && \
    [ -f "$root/browser-runtime/playwright-core/index.js" ] && \
    [ -f "$root/browser-runtime/playwright-core/lib/coreBundle.js" ]
}

has_bundled_assets() {
    has_bundled_assets_at "$ROOT_DIR"
}

has_required_sandbox_asset_at() {
    local root="$1"
    local platform="${SYNERGY_INSTALL_PLATFORM:-$(uname -s)}"
    case "$platform" in
        Linux*) [ -f "$root/sandbox/synergy-sandbox-linux" ] ;;
        MINGW*|MSYS*|CYGWIN*|Windows*) [ -f "$root/sandbox/synergy-sandbox-windows.exe" ] ;;
        *) return 0 ;;
    esac
}


has_runtime_executable_at() {
    local root="$1"
    local platform="${SYNERGY_INSTALL_PLATFORM:-$(uname -s)}"
    case "$platform" in
        MINGW*|MSYS*|CYGWIN*|Windows*) [ -f "$root/bin/synergy.exe" ] ;;
        *) [ -f "$root/bin/synergy" ] ;;
    esac
}

has_complete_bundle_at() {
    local root="$1"
    has_runtime_executable_at "$root" && has_bundled_assets_at "$root" && has_required_sandbox_asset_at "$root" || return 1
    if [ -f "$root/runtime-manifest.sha256" ]; then
        verify_runtime_manifest "$root"
    fi
}

has_legacy_complete_bundle_at() {
    local root="$1"
    has_runtime_executable_at "$root" && has_legacy_bundled_assets_at "$root" && has_required_sandbox_asset_at "$root"
}

has_installable_bundle_at() {
    local root="$1"
    if [ -f "$root/runtime-manifest.sha256" ]; then
        has_complete_bundle_at "$root"
        return
    fi
    has_legacy_complete_bundle_at "$root"
}

has_complete_bundle() {
    has_complete_bundle_at "$ROOT_DIR"
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
        return
    fi
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d ' ' -f 1
        return
    fi
    print_message error "No SHA-256 tool is available; install sha256sum or shasum."
    return 1
}

verify_downloaded_archive_checksum() {
    local archive="$1"
    local checksum_manifest="$2"
    local archive_name="$3"
    local line expected name actual
    local matches=0

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ ! "$line" =~ ^([a-f0-9]{64})\ \ ([^/\\[:space:]]+)$ ]]; then
            print_message error "CLI checksum manifest contains an invalid entry: $checksum_manifest"
            return 1
        fi
        expected="${BASH_REMATCH[1]}"
        name="${BASH_REMATCH[2]}"
        if [ "$name" = "$archive_name" ]; then
            matches=$((matches + 1))
        fi
    done < "$checksum_manifest"

    if [ "$matches" -ne 1 ]; then
        print_message error "CLI checksum manifest must contain exactly one entry for: $archive_name"
        return 1
    fi

    expected=$(while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^([a-f0-9]{64})\ \ ([^/\\[:space:]]+)$ ]] && [ "${BASH_REMATCH[2]}" = "$archive_name" ]; then
            printf "%s\n" "${BASH_REMATCH[1]}"
        fi
    done < "$checksum_manifest")
    actual=$(sha256_file "$archive") || return 1
    if [ "$actual" != "$expected" ]; then
        print_message error "Downloaded Synergy archive checksum mismatch: $archive_name"
        return 1
    fi
}

runtime_manifest_has_entry() {
    local manifest="$1"
    local wanted="$2"
    local line relative
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ ! "$line" =~ ^[a-f0-9]{64}\ \ ([^[:space:]]+)$ ]]; then
            return 1
        fi
        relative="${BASH_REMATCH[1]}"
        if [ "$relative" = "$wanted" ]; then
            return 0
        fi
    done < "$manifest"
    return 1
}

verify_runtime_manifest_contract() {
    local manifest="$1"
    local required
    local platform="${SYNERGY_INSTALL_PLATFORM:-$(uname -s)}"
    local musl="${is_musl:-false}"
    local native_helpers=()
    case "$platform" in
        Linux*)
            for required in "bin/synergy" "sandbox/synergy-sandbox-linux"; do
                if ! runtime_manifest_has_entry "$manifest" "$required"; then
                    print_message error "runtime manifest is missing required entry: $required"
                    return 1
                fi
            done
            native_helpers=("bin/ast-grep" "vec0.so")
            ;;
        MINGW*|MSYS*|CYGWIN*|Windows*)
            for required in "bin/synergy.exe" "sandbox/synergy-sandbox-windows.exe"; do
                if ! runtime_manifest_has_entry "$manifest" "$required"; then
                    print_message error "runtime manifest is missing required entry: $required"
                    return 1
                fi
            done
            native_helpers=("bin/ast-grep.exe" "vec0.dll")
            ;;
        *)
            if ! runtime_manifest_has_entry "$manifest" "bin/synergy"; then
                print_message error "runtime manifest is missing required entry: bin/synergy"
                return 1
            fi
            native_helpers=("bin/ast-grep" "vec0.dylib")
            ;;
    esac
    for required in \
        "watcher.node" \
        "app/index.html" \
        "schema/config.schema.json" \
        "browser-runtime/playwright-core/package.json" \
        "browser-runtime/playwright-core/index.js" \
        "browser-runtime/playwright-core/lib/coreBundle.js" \
        "lib/onnxruntime-web/ort-wasm-simd-threaded.asyncify.mjs" \
        "lib/onnxruntime-web/ort-wasm-simd-threaded.asyncify.wasm" \
        "lib/resvg-wasm/index_bg.wasm" \
        "lib/resvg-wasm/LICENSE-MPL-2.0.txt" \
        "lib/resvg-wasm/THIRD_PARTY_NOTICES.txt" \
        "lib/resvg-wasm/fonts/LICENSE-OFL-1.1.txt" \
        "lib/resvg-wasm/fonts/noto-sans-sc-chinese-simplified-400-normal.woff2" \
        "lib/resvg-wasm/fonts/noto-sans-sc-latin-400-normal.woff2" \
        "lib/holos-cli/index.js" \
        "lib/holos-cli/vendor/clarus-shared/index.js" \
        "lib/holos-cli/node_modules/ws/package.json" \
        "lib/holos-cli/node_modules/zod/package.json"; do
        if ! runtime_manifest_has_entry "$manifest" "$required"; then
            print_message error "runtime manifest is missing required entry: $required"
            return 1
        fi
    done
    if [ "$musl" != "true" ]; then
        for required in "${native_helpers[@]}"; do
            if ! runtime_manifest_has_entry "$manifest" "$required"; then
                print_message error "runtime manifest is missing required entry: $required"
                return 1
            fi
        done
    fi
}

runtime_file_is_safe() {
    local root="$1"
    local relative="$2"
    local current="$root"
    local component index
    local components=()
    IFS='/' read -r -a components <<< "$relative"
    for index in "${!components[@]}"; do
        component="${components[$index]}"
        current="$current/$component"
        if [ -L "$current" ]; then
            return 1
        fi
        if [ "$index" -lt "$((${#components[@]} - 1))" ]; then
            [ -d "$current" ] || return 1
        else
            [ -f "$current" ] || return 1
        fi
    done
}

verify_runtime_manifest() {
    local bundle_root="$1"
    local manifest="$bundle_root/runtime-manifest.sha256"
    [ -f "$manifest" ] || return 0
    verify_runtime_manifest_contract "$manifest" || return 1

    local line expected relative actual
    local seen=$'\n'
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ ! "$line" =~ ^([a-f0-9]{64})\ \ ([^[:space:]]+)$ ]]; then
            print_message error "runtime manifest contains an invalid entry: $manifest"
            return 1
        fi
        expected="${BASH_REMATCH[1]}"
        relative="${BASH_REMATCH[2]}"
        case "$relative" in
            ""|.|..|./*|/*|*\\*|[A-Za-z]:*|../*|*/../*|*/..|*/./*|*/.) print_message error "runtime manifest contains an unsafe path: $relative"; return 1 ;;
        esac
        if [[ "$seen" == *$'\n'"$relative"$'\n'* ]]; then
            print_message error "runtime manifest contains a duplicate entry: $relative"
            return 1
        fi
        seen+="$relative"$'\n'
        if ! runtime_file_is_safe "$bundle_root" "$relative"; then
            print_message error "runtime manifest file is missing or unsafe: $relative"
            return 1
        fi
        actual=$(sha256_file "$bundle_root/$relative") || return 1
        if [ "$actual" != "$expected" ]; then
            print_message error "runtime manifest checksum mismatch: $relative"
            return 1
        fi
    done < "$manifest"
}

bundle_contains_symlink() {
    [ -n "$(find "$1" -type l -print -quit 2>/dev/null)" ]
}

archive_member_name_is_safe() {
    local member="$1"
    local component
    case "$member" in
        ""|/*|*\\*|[A-Za-z]:*) return 1 ;;
    esac
    while [[ "$member" == ./* ]]; do
        member="${member#./}"
    done
    IFS='/' read -r -a components <<< "$member"
    for component in "${components[@]}"; do
        if [ "$component" = ".." ]; then
            return 1
        fi
    done
}

validated_archive_members() {
    local archive="$1"
    local archive_type="$2"
    local members
    local member
    if [ "$archive_type" = "tar" ]; then
        if tar -tvzf "$archive" | grep -Eq '^[lh]'; then
            print_message error "Release archive contains a symbolic or hard link." >&2
            return 1
        fi
        members=$(tar -tzf "$archive") || return 1
    else
        if unzip -Z -l "$archive" | grep -Eq '^l'; then
            print_message error "Release archive contains a symbolic link." >&2
            return 1
        fi
        members=$(unzip -Z1 "$archive") || return 1
    fi
    while IFS= read -r member; do
        if ! archive_member_name_is_safe "$member"; then
            print_message error "Release archive contains an unsafe path: $member" >&2
            return 1
        fi
    done <<< "$members"
    printf '%s\n' "$members"
}

validate_archive_members() {
    validated_archive_members "$1" "$2" >/dev/null
}

require_published_checksum_before_extraction() {
    local archive="$1"
    local archive_type="$2"
    local checksum_verified="$3"
    local checksum_name="$4"
    local members
    local member
    members=$(validated_archive_members "$archive" "$archive_type") || return 1
    if [ "$checksum_verified" = "true" ]; then
        return 0
    fi
    while IFS= read -r member; do
        while [[ "$member" == */ ]]; do
            member="${member%/}"
        done
        case "$member" in
            runtime-manifest.sha256|./runtime-manifest.sha256)
                print_message error "Published CLI checksum is unavailable for this manifest-backed Synergy release: $checksum_name"
                return 1
                ;;
        esac
    done <<< "$members"
}

replace_bundle_directory() {
    local source="$1"
    local destination="$2"
    local staged="${destination}.install.$$"
    local backup="${destination}.backup.$$"

    rm -rf "$staged" "$backup"
    cp -R "$source" "$staged"
    if [ -e "$destination" ]; then
        mv "$destination" "$backup"
    fi
    if mv "$staged" "$destination"; then
        rm -rf "$backup"
        return 0
    fi
    rm -rf "$staged"
    if [ -e "$backup" ]; then
        mv "$backup" "$destination"
    fi
    return 1
}

install_bin_contents() {
    local bundle_bin="$1"
    local source name destination staged

    for source in "$bundle_bin"/* "$bundle_bin"/.[!.]* "$bundle_bin"/..?*; do
        [ -e "$source" ] || [ -L "$source" ] || continue
        name=$(basename "$source")
        destination="$INSTALL_DIR/$name"

        if [ -d "$source" ]; then
            mkdir -p "$destination"
            cp -R "$source/." "$destination/"
            continue
        fi

        staged="$INSTALL_DIR/.${name}.install.$$"
        rm -f "$staged"
        cp -P "$source" "$staged"
        mv -f "$staged" "$destination"
    done
}

backup_managed_runtime() {
    local backup="$1"
    local name
    rm -rf "$backup"
    mkdir -p "$backup" || return 1
    for name in app schema browser-runtime lib sandbox bin runtime-manifest.sha256 vec0.so vec0.dylib vec0.dll watcher.node; do
        if [ -e "$ROOT_DIR/$name" ] || [ -L "$ROOT_DIR/$name" ]; then
            cp -RP "$ROOT_DIR/$name" "$backup/$name" || return 1
        fi
    done
}

restore_managed_runtime() {
    local backup="$1"
    local name
    rm -rf "$ROOT_DIR/app" "$ROOT_DIR/schema" "$ROOT_DIR/browser-runtime" "$ROOT_DIR/lib" "$ROOT_DIR/sandbox" "$ROOT_DIR/bin"
    rm -f "$ROOT_DIR/runtime-manifest.sha256" "$ROOT_DIR/vec0.so" "$ROOT_DIR/vec0.dylib" "$ROOT_DIR/vec0.dll" "$ROOT_DIR/watcher.node"
    mkdir -p "$ROOT_DIR" || return 1
    for name in app schema browser-runtime lib sandbox bin runtime-manifest.sha256 vec0.so vec0.dylib vec0.dll watcher.node; do
        if [ -e "$backup/$name" ] || [ -L "$backup/$name" ]; then
            cp -RP "$backup/$name" "$ROOT_DIR/$name" || return 1
        fi
    done
}

apply_bundle_contents() {
    local bundle_root="$1"
    local vec
    mkdir -p "$ROOT_DIR" "$INSTALL_DIR" || return 1

    if [ -d "$bundle_root/app" ]; then
        replace_bundle_directory "$bundle_root/app" "$ROOT_DIR/app" || return 1
    fi
    if [ -d "$bundle_root/schema" ]; then
        replace_bundle_directory "$bundle_root/schema" "$ROOT_DIR/schema" || return 1
    fi
    if [ -d "$bundle_root/browser-runtime" ]; then
        replace_bundle_directory "$bundle_root/browser-runtime" "$ROOT_DIR/browser-runtime" || return 1
    fi
    if [ -d "$bundle_root/lib" ]; then
        replace_bundle_directory "$bundle_root/lib" "$ROOT_DIR/lib" || return 1
    fi
    if [ -d "$bundle_root/sandbox" ]; then
        replace_bundle_directory "$bundle_root/sandbox" "$ROOT_DIR/sandbox" || return 1
    fi

    rm -f "$INSTALL_DIR/ast-grep" "$INSTALL_DIR/ast-grep.exe" "$ROOT_DIR/vec0.so" "$ROOT_DIR/vec0.dylib" "$ROOT_DIR/vec0.dll" "$ROOT_DIR/watcher.node" || return 1
    for vec in "$bundle_root/vec0.so" "$bundle_root/vec0.dylib" "$bundle_root/vec0.dll"; do
        if [ -f "$vec" ]; then
            cp "$vec" "$ROOT_DIR/" || return 1
        fi
    done
    if [ -f "$bundle_root/watcher.node" ]; then
        cp "$bundle_root/watcher.node" "$ROOT_DIR/" || return 1
    fi

    if [ -d "$bundle_root/bin" ]; then
        install_bin_contents "$bundle_root/bin" || return 1
    fi
    if [ -f "$bundle_root/runtime-manifest.sha256" ]; then
        cp "$bundle_root/runtime-manifest.sha256" "$ROOT_DIR/runtime-manifest.sha256" || return 1
        verify_runtime_manifest "$ROOT_DIR" || return 1
    else
        rm -f "$ROOT_DIR/runtime-manifest.sha256" || return 1
    fi
    if ! has_installable_bundle_at "$ROOT_DIR"; then
        print_message error "Installed Synergy runtime is incomplete."
        return 1
    fi

    if [ -f "$INSTALL_DIR/synergy" ]; then
        chmod 755 "$INSTALL_DIR/synergy" || return 1
    fi
    if [ -f "$INSTALL_DIR/synergy.exe" ]; then
        chmod 755 "$INSTALL_DIR/synergy.exe" || return 1
    fi
    if [ -f "$INSTALL_DIR/ast-grep" ]; then
        chmod 755 "$INSTALL_DIR/ast-grep" || return 1
    fi
    if [ -f "$INSTALL_DIR/ast-grep.exe" ]; then
        chmod 755 "$INSTALL_DIR/ast-grep.exe" || return 1
    fi
    if [ -f "$ROOT_DIR/sandbox/synergy-sandbox-linux" ]; then
        chmod 755 "$ROOT_DIR/sandbox/synergy-sandbox-linux" || return 1
    fi
}

install_bundle_contents() {
    local bundle_root="$1"
    local backup="${ROOT_DIR}.runtime-backup.$$"
    if [ ! -f "$bundle_root/runtime-manifest.sha256" ]; then
        print_message warning "${ORANGE}Warning: legacy archive has no runtime manifest; verifying required files only.${NC}"
    fi
    verify_runtime_manifest "$bundle_root" || return 1
    if ! has_installable_bundle_at "$bundle_root"; then
        print_message error "Release archive is incomplete; required runtime assets are missing."
        return 1
    fi
    if bundle_contains_symlink "$bundle_root"; then
        print_message error "Release archive contains symbolic links."
        return 1
    fi

    backup_managed_runtime "$backup" || return 1
    if apply_bundle_contents "$bundle_root"; then
        rm -rf "$backup"
        return 0
    fi

    print_message error "Synergy installation failed; restoring the previous runtime."
    if restore_managed_runtime "$backup"; then
        rm -rf "$backup"
    else
        print_message error "Failed to restore the previous Synergy runtime. Recovery backup preserved at: $backup"
    fi
    return 1
}

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

package_manager_channel_version() {
    local manager="$1"
    local output=""

    command -v "$manager" >/dev/null 2>&1 || return 1
    case "$manager" in
        npm) output=$(npm list -g --depth=0 @ericsanchezok/synergy 2>/dev/null) || return 1 ;;
        yarn) output=$(yarn global list --pattern @ericsanchezok/synergy 2>/dev/null) || return 1 ;;
        pnpm) output=$(pnpm list -g --depth=0 @ericsanchezok/synergy 2>/dev/null) || return 1 ;;
        bun) output=$(bun pm ls -g 2>/dev/null) || return 1 ;;
        *) return 1 ;;
    esac

    [[ "$output" == *"@ericsanchezok/synergy"* ]] || return 1
    if [[ "$output" =~ @ericsanchezok/synergy@([0-9][0-9A-Za-z.+-]*) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    else
        printf '%s\n' "version unknown"
    fi
}

warn_about_package_manager_installations() {
    local manager version
    local channels=""
    for manager in npm yarn pnpm bun; do
        if version=$(package_manager_channel_version "$manager"); then
            channels="${channels}\n  - ${manager}: ${version}"
        fi
    done

    [ -n "$channels" ] || return 0
    print_message warning "${ORANGE}Warning: another Synergy installation channel is already present.${NC}"
    printf '%b\n' "$channels"
    if command -v synergy >/dev/null 2>&1; then
        print_message warning "${MUTED}  - PATH currently resolves synergy to: $(command -v synergy)${NC}"
    fi
    print_message warning "${MUTED}The standalone installer will continue and will not remove other installations.${NC}"
    print_message warning "${MUTED}After installation, run 'synergy doctor' and remove extra channels with 'synergy uninstall --installation-only --method <channel>'.${NC}"
}

is_linux_install() {
    [[ "${SYNERGY_INSTALL_PLATFORM:-$(uname -s)}" == Linux* ]]
}

has_bubblewrap() {
    command -v bwrap >/dev/null 2>&1
}

detect_bubblewrap_package_manager() {
    local manager
    for manager in apt-get dnf pacman; do
        if command -v "$manager" >/dev/null 2>&1; then
            printf '%s\n' "$manager"
            return 0
        fi
    done
    return 1
}

bubblewrap_install_command() {
    case "$1" in
        apt-get) printf '%s\n' "apt-get install -y bubblewrap" ;;
        dnf) printf '%s\n' "dnf install -y bubblewrap" ;;
        pacman) printf '%s\n' "pacman -S --noconfirm bubblewrap" ;;
        *) return 1 ;;
    esac
}

is_root_user() {
    [ "$(id -u)" -eq 0 ]
}

can_prompt_for_bubblewrap_install() {
    [ -t 2 ] || return 1
    { : </dev/tty >/dev/tty; } 2>/dev/null
}

confirm_bubblewrap_install() {
    local response
    printf 'Bubblewrap is required for the Linux sandbox. Install it now? [y/N] ' >/dev/tty
    IFS= read -t 30 -r response </dev/tty || return 1
    case "$response" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

print_manual_bubblewrap_command() {
    local command="$1"
    if is_root_user; then
        print_message warning "${ORANGE}Run this command manually: ${command}${NC}"
    elif command -v sudo >/dev/null 2>&1; then
        print_message warning "${ORANGE}Run this command manually: sudo ${command}${NC}"
    else
        print_message warning "${ORANGE}Run this command as root: ${command}${NC}"
    fi
}

install_bubblewrap() {
    local manager=$1

    if is_root_user; then
        case "$manager" in
            apt-get) apt-get install -y bubblewrap ;;
            dnf) dnf install -y bubblewrap ;;
            pacman) pacman -S --noconfirm bubblewrap ;;
            *) return 1 ;;
        esac
        return
    fi

    command -v sudo >/dev/null 2>&1 || return 1
    case "$manager" in
        apt-get) sudo apt-get install -y bubblewrap ;;
        dnf) sudo dnf install -y bubblewrap ;;
        pacman) sudo pacman -S --noconfirm bubblewrap ;;
        *) return 1 ;;
    esac
}

ensure_linux_bubblewrap() {
    is_linux_install || return 0
    has_bubblewrap && return 0

    local manager
    if ! manager=$(detect_bubblewrap_package_manager); then
        print_message warning "${ORANGE}Linux sandbox prerequisite missing: install Bubblewrap with your system package manager.${NC}"
        return 0
    fi

    local command
    if ! command=$(bubblewrap_install_command "$manager"); then
        print_message warning "${ORANGE}Linux sandbox prerequisite missing: install Bubblewrap with your system package manager.${NC}"
        return 0
    fi

    if ! can_prompt_for_bubblewrap_install || ! confirm_bubblewrap_install; then
        print_manual_bubblewrap_command "$command"
        return 0
    fi

    print_message info "${MUTED}Installing Bubblewrap with ${manager}...${NC}"
    if install_bubblewrap "$manager"; then
        print_message info "${MUTED}Bubblewrap installed successfully.${NC}"
        return 0
    fi

    print_message warning "${ORANGE}Automatic Bubblewrap installation failed.${NC}"
    print_manual_bubblewrap_command "$command"
    return 0
}

print_post_install_message() {
    echo -e ""
    echo -e "${MUTED}                       ${NC}                  "
    echo -e "${MUTED}█▀▀ █  █ █▀▀▄ █▀▀█ █▀▀█ █▀▀▀ █  █${NC}"
    echo -e "${MUTED}▀▀█ █▄▄█ █  █ █▀▀▀ █▄▄▀ █ ▀█ █▄▄█${NC}"
    echo -e "${MUTED}▀▀▀  ▄▄█ ▀  ▀ ▀▀▀▀ ▀ ▀▀ ▀▀▀▀  ▄▄█${NC}"
    echo -e ""
    echo -e ""
    echo -e "${MUTED}Synergy is ready! To start:${NC}"
    echo -e ""
    echo -e "synergy  ${MUTED}# Run command${NC}"
    echo -e ""
    echo -e "${MUTED}For more information visit ${NC}https://github.com/SII-Holos/synergy"
    echo -e ""
    echo -e ""
}

check_version() {
    if command -v synergy >/dev/null 2>&1; then
        local installed_version
        installed_version=$(synergy --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        elif has_complete_bundle; then
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
            return 1
        fi
    fi
    return 0
}

install_synergy() {
    if [ -n "$binary_path" ]; then
        install_from_binary
    elif check_version; then
        download_and_install
    fi

    ensure_linux_bubblewrap
}

download_archive_standard() {
    local url="$1"
    local output="$2"
    if ! curl --proto '=https' -# -fL -o "$output" "$url"; then
        rm -f "$output"
        print_message error "Failed to download Synergy release archive: $url"
        return 1
    fi
}

download_cli_checksums() {
    local url="$1"
    local output="$2"
    local status
    if ! status=$(curl --proto '=https' -sSL -w '%{http_code}' -o "$output" "$url"); then
        rm -f "$output"
        print_message error "Failed to download the published CLI checksum asset."
        return 1
    fi
    case "$status" in
        2??) return 0 ;;
        404)
            rm -f "$output"
            return "$CHECKSUM_ASSET_NOT_FOUND"
            ;;
        *)
            rm -f "$output"
            print_message error "Failed to download the published CLI checksum asset (HTTP $status)."
            return 1
            ;;
    esac
}



progress_trace_file() {
    printf "%s/.synergy-install-progress.trace\n" "$(dirname "$1")"
}

if [ "${SYNERGY_INSTALL_LIBRARY_MODE:-}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        url="https://github.com/SII-Holos/synergy/releases/latest/download/$filename"
        specific_version=$(curl -s https://api.github.com/repos/SII-Holos/synergy/releases/latest | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')

        if [[ $? -ne 0 || -z "$specific_version" ]]; then
            echo -e "${RED}Failed to fetch version information${NC}"
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        url="https://github.com/SII-Holos/synergy/releases/download/v${requested_version}/$filename"
        specific_version=$requested_version

        # Verify the release exists before downloading
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "https://github.com/SII-Holos/synergy/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/SII-Holos/synergy/releases${NC}"
            exit 1
        fi
    fi
fi



unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}


download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tracefile
    tracefile=$(progress_trace_file "$output")

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --proto '=https' --fail --trace-ascii "$tracefile" -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

download_and_install() {
    local tmp_dir
    local checksum_name="Synergy-${specific_version}-cli-checksums.txt"
    local checksum_url="${url%/*}/$checksum_name"
    local checksum_verified=false
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/synergy_install.XXXXXX") || return 1
    chmod 700 "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        if ! download_archive_standard "$url" "$tmp_dir/$filename"; then
            rm -rf "$tmp_dir"
            return 1
        fi
    fi

    local checksum_status=0
    download_cli_checksums "$checksum_url" "$tmp_dir/$checksum_name" || checksum_status=$?
    if [ "$checksum_status" -eq 0 ]; then
        if ! verify_downloaded_archive_checksum "$tmp_dir/$filename" "$tmp_dir/$checksum_name" "$filename"; then
            rm -rf "$tmp_dir"
            return 1
        fi
        checksum_verified=true
    elif [ "$checksum_status" -eq "$CHECKSUM_ASSET_NOT_FOUND" ]; then
        print_message warning "${ORANGE}Warning: published CLI checksum is unavailable; installing a legacy Synergy release only if its archive has no runtime manifest.${NC}"
    else
        rm -rf "$tmp_dir"
        return 1
    fi

    local archive_type=zip
    if [ "$os" = "linux" ]; then
        archive_type=tar
    fi
    if ! require_published_checksum_before_extraction "$tmp_dir/$filename" "$archive_type" "$checksum_verified" "$checksum_name"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ "$os" = "linux" ]; then
        if ! tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"; then
            rm -rf "$tmp_dir"
            return 1
        fi
    else
        if ! unzip -q "$tmp_dir/$filename" -d "$tmp_dir"; then
            rm -rf "$tmp_dir"
            return 1
        fi
    fi

    local install_status=0
    install_bundle_contents "$tmp_dir" || install_status=$?
    rm -rf "$tmp_dir"
    return "$install_status"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}synergy ${MUTED}from: ${NC}$binary_path"
    mkdir -p "$INSTALL_DIR"
    cp "$binary_path" "${INSTALL_DIR}/synergy"
    chmod 755 "${INSTALL_DIR}/synergy"

    if ! has_bundled_assets; then
        print_message warning "${ORANGE}Warning: Installed only the binary. Web UI, schema, Browser, and local embedding runtime assets were not provided.${NC}"
        print_message warning "${MUTED}Use the release archive installer to install all bundled runtime assets.${NC}"
    fi
}


install_synergy
warn_about_package_manager_installations || true


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# synergy" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}synergy ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="$HOME/.zshrc $HOME/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

print_post_install_message
