{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "synergy",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun ./script/dev.ts",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "desktop:pack": "bun run --cwd apps/desktop desktop:pack",
    "desktop:dist": "bun run --cwd apps/desktop desktop:dist",
    "desktop:test": "bun run --cwd apps/desktop desktop:test",
    "perf:load": "bun script/performance-load.ts",
    "perf:benchmark": "bun script/performance-benchmark.ts",
    "perf:memory": "bun script/session-memory-benchmark.ts",
    "perf:memory:runtime": "bun script/session-memory-runtime-benchmark.ts",
    "perf:memory:runtime:matrix": "bun script/session-memory-runtime-benchmark.ts --scenario all",
    "perf:playwright": "bun script/performance-playwright.ts",
    "perf:tools:test": "bun test --config /dev/null test/script/performance-tools.test.ts",
    "release:test": "bun test --config /dev/null test/script/release test/script/install.test.ts",
    "release:verify-upgrade": "bun script/release/verify-released-upgrade.ts",
    "format": "./script/format.ts",
    "format:check": "prettier --ignore-unknown --cache --cache-strategy content --check . \"!.artifacts/**\"",
    "lint": "oxlint -c oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint -c oxlintrc.json --fix",
    "deadcode": "bun script/deadcode.ts",
    "monorepo:check": "bunx sherif@1.13.0",
    "workflow:check": "bun script/workflow-check.ts",
    "skill:check": "bun script/skill-check.ts",
    "package-guide:check": "bun script/package-guide-check.ts",
    "test-policy:check": "bun script/test-policy-check.ts",
    "test-layout:check": "bun test --config /dev/null test/script/test-layout-check.test.ts && bun script/test-layout-check.ts",
    "localization:source": "bun script/localization-check.ts --strict",
    "localization:check": "bun run --cwd apps/web i18n:check",
    "secrets:check": "bun script/secrets-check.ts",
    "package:check": "bun script/package-check.ts",
    "doc:gen": "bun script/gen/gen-cli-reference.ts && bun script/gen/gen-config-reference.ts && bun script/gen/gen-tool-catalog.ts",
    "doc:gen:check": "bun script/gen/gen-cli-reference.ts --check && bun script/gen/gen-config-reference.ts --check && bun script/gen/gen-tool-catalog.ts --check",
    "brand:gen": "bun script/gen/gen-brand-assets.ts",
    "brand:gen:check": "bun script/gen/gen-brand-assets.ts --check",
    "doc:check": "bun script/doc-check.ts",
    "decision:check": "bun script/decision-check.ts",
    "deps:analyze": "bun script/dep-analyze.ts",
    "deps:snapshot": "bun script/dep-analyze.ts --snapshot",
    "deps:check": "bun script/workspace-dependencies.ts && bun run --bun depcruise --config .dependency-cruiser.cjs --no-progress --output-type err packages/harness/src packages/local-runtime/src packages/cli/src packages/server/src packages/browser-runtime/src packages/library/src packages/note/src",
    "coverage:check": "bun turbo build --filter=@ericsanchezok/synergy-plugin && bun script/coverage-check.ts",
    "quality:quick": "bun script/gates.ts local",
    "verify": "bun script/verify.ts",
    "quality": "bun run quality:quick && bun run release:test && bun turbo test",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "test": "echo 'Root test is intentionally disabled. Use bun run quality, bun turbo test, or cd packages/harness && bun test.' && exit 1",
    "plugin-ui:test": "bun script/plugin-ui-test.ts",
    "ci:plan": "bun script/ci.ts plan",
    "ci:run": "bun script/ci.ts run",
    "ci:verify": "bun script/ci.ts verify",
    "bench": "uv run --locked --project benchmark synergy-bench",
    "test:computer-native": "bun run --cwd apps/desktop test:computer-native",
    "test:computer-acceptance": "bun run --cwd apps/desktop test:computer-acceptance",
    "feature:gen": "bun script/gen/gen-feature-catalog.ts",
    "feature:check": "bun script/gen/gen-feature-catalog.ts --check"
  },
  "workspaces": {
    "packages": [
      "packages/harness",
      "packages/local-runtime",
      "packages/cli",
      "packages/server",
      "packages/presets",
      "packages/browser-runtime",
      "packages/computer-runtime",
      "packages/library",
      "packages/digital-twin",
      "packages/note",
      "packages/workflows",
      "packages/connections",
      "packages/workbench",
      "packages/mcp",
      "packages/lsp",
      "packages/formatter",
      "packages/acp",
      "packages/external-agents",
      "packages/code-tools",
      "packages/media",
      "packages/plugin-host",
      "packages/testing",
      "packages/browser-core",
      "packages/computer-protocol",
      "packages/plugin",
      "packages/plugin-kit",
      "packages/sdk/js",
      "packages/ui",
      "packages/secret-detection",
      "packages/util",
      "apps/web",
      "apps/desktop",
      "benchmark",
      "packages/agent-runtime",
      "packages/agenda",
      "packages/light-loop",
      "packages/blueprint",
      "packages/lattice",
      "packages/boss",
      "packages/anima",
      "packages/channels",
      "packages/channel-feishu",
      "packages/github",
      "packages/channel-github",
      "packages/holos",
      "packages/channel-clarus",
      "packages/email",
      "packages/agenda-blueprint",
      "packages/agenda-light-loop",
      "packages/plugin-agenda",
      "packages/plugin-blueprint",
      "packages/plugin-light-loop",
      "packages/boss-feishu",
      "packages/github-agenda",
      "packages/channel-blueprint",
      "packages/channel-light-loop",
      "packages/channel-lattice"
    ],
    "catalog": {
      "@babel/core": "8.0.7",
      "@babel/preset-typescript": "8.0.7",
      "@happy-dom/global-registrator": "21.0.3",
      "@types/babel__core": "7.20.5",
      "@types/bun": "1.4.3",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "ulid": "3.0.2",
      "@kobalte/core": "0.13.14",
      "@types/node": "24.19.2",
      "@tsconfig/node22": "22.0.6",
      "@tsconfig/bun": "1.0.11",
      "@cloudflare/workers-types": "4.20251008.0",
      "@pierre/diffs": "1.5.2",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.3.3",
      "diff": "9.0.0",
      "ai": "7.0.143",
      "hono": "4.13.13",
      "hono-openapi": "1.1.2",
      "fuzzysort": "4.0.2",
      "lru-cache": "11.5.3",
      "katex": "0.19.0",
      "marked": "18.1.1",
      "marked-shiki": "1.2.1",
      "pdfjs-dist": "6.4.299",
      "typescript": "7.0.2",
      "zod": "4.6.7",
      "remeda": "2.52.0",
      "shiki": "4.5.0",
      "@shikijs/themes": "4.5.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.3",
      "virtua": "0.42.3",
      "vite": "8.3.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "1.0.0",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "babel-preset-solid": "1.9.16",
      "solid-js": "1.9.17",
      "vite-plugin-solid": "2.11.14",
      "@lingui/cli": "6.10.0",
      "@lingui/core": "6.10.0",
      "@lingui/format-po": "6.10.0",
      "@lingui/solid": "6.10.0",
      "@lingui/vite-plugin": "6.10.0",
      "@typescript/typescript6": "6.0.2"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@ericsanchezok/synergy-harness": "workspace:*",
    "@ericsanchezok/synergy-local-runtime": "workspace:*",
    "@ericsanchezok/synergy-plugin": "workspace:*",
    "@ericsanchezok/synergy-sdk": "workspace:*",
    "@ericsanchezok/synergy-testing": "workspace:*",
    "@ericsanchezok/synergy-workbench": "workspace:*",
    "@napi-rs/canvas": "1.0.11",
    "@tsconfig/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "dependency-cruiser": "18.6.0",
    "husky": "9.1.7",
    "knip": "6.42.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "turbo": "2.11.9",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SII-Holos/synergy.git"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eventsource-parser": "3.1.0",
    "isbinaryfile": "5.0.7",
    "prosemirror-model": "1.25.10",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.42.0"
  },
  "patchedDependencies": {
    "virtua@0.42.3": "patches/virtua@0.42.3.patch",
    "streaming-markdown@0.2.15": "patches/streaming-markdown@0.2.15.patch",
    "solid-js@1.9.17": "patches/solid-js@1.9.17.patch",
    "@pierre/diffs@1.5.2": "patches/@pierre%2Fdiffs@1.5.2.patch",
    "@kobalte/core@0.13.14": "patches/@kobalte%2Fcore@0.13.14.patch",
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch",
    "@hey-api/openapi-ts@0.88.1": "patches/@hey-api%2Fopenapi-ts@0.88.1.patch",
    "@kobalte/utils@0.9.2": "patches/@kobalte%2Futils@0.9.2.patch",
    "@ai-sdk/openai@4.0.96": "patches/@ai-sdk%2Fopenai@4.0.96.patch"
  }
}
