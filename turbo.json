{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["SYNERGY_TEST_LINUX_SANDBOX_E2E"]
    },
    "package:check": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
