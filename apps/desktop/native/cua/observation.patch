 ///
 /// Tries ScreenCaptureKit first; falls back to the `screencapture` CLI on
 /// native error or empty output.
+pub(crate) fn screenshot_window_bytes_verified(pid: i32, window_id: u32) -> anyhow::Result<Vec<u8>> {
+    run_native_capture_worker(native_capture_gate(), WINDOW_CAPTURE_NATIVE_TIMEOUT, move || {
+        let before = crate::synergy::identity(pid, window_id).ok_or_else(|| anyhow::anyhow!("capture_identity_unverified"))?;
+        let expected = current_window_capture_identity(window_id)?;
+        let plan = build_window_capture_plan(window_id, expected)?;
+        let rect = plan.filter.content_rect();
+        let scale = f64::from(plan.filter.point_pixel_scale());
+        let bounds = crate::windows::window_bounds_by_id(window_id).ok_or_else(|| anyhow::anyhow!("capture_identity_unverified"))?;
+        if !crate::synergy::same_plane(before.frame, [bounds.x,bounds.y,bounds.width,bounds.height], scale)
+            || !crate::synergy::same_plane([0.0,0.0,before.frame[2],before.frame[3]], [0.0,0.0,rect.size.width,rect.size.height], scale) {
+            anyhow::bail!("capture_representation_mismatch");
+        }
+        let bytes = capture_window_from_plan(window_id, &plan)?;
+        if current_window_capture_identity(window_id)? != expected { anyhow::bail!("capture_identity_changed"); }
+        Ok(bytes)
+    })
+}
