{
  "name": "@ericsanchezok/synergy-util",
  "version": "1.1.26",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": {
      "bun": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./pty-keys": "./src/pty-keys.ts",
    "./terminal": {
      "types": "./src/terminal.ts",
      "bun": "./src/terminal.ts",
      "import": "./dist/terminal.js"
    },
    "./cli-command": {
      "types": "./src/cli-command.ts",
      "bun": "./src/cli-command.ts",
      "import": "./dist/cli-command.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test test/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/yargs": "17.0.33",
    "typescript": "catalog:"
  }
}
