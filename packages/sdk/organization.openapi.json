          "role": { "type": "string", "enum": ["owner", "admin", "member"] },
          "state": { "type": "string", "const": "removed" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["expectedRevision"],
        "additionalProperties": false
      },
