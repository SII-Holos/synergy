          "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
        },
        "required": ["currentPassword", "password"],
        "additionalProperties": false
      },
      "OrgTokenResult": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expiresAt": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["token", "expiresAt"],
        "additionalProperties": false
      },
      "OrgInviteCreate": {
        "type": "object",
        "properties": { "role": { "type": "string", "enum": ["admin", "member"] } },
        "required": ["role"],
        "additionalProperties": false
      },
      "OrgInviteConsume": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requestID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "loginName": { "type": "string", "maxLength": 320 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
        },
        "required": ["token", "requestID", "loginName", "displayName", "password"],
        "additionalProperties": false
      },
      "OrgOrganization": {
