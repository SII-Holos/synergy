  "components": {
    "schemas": {
      "OrgAccount": {
        "type": "object",
        "properties": {
          "accountID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "orgID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "loginName": { "type": "string", "maxLength": 320 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "role": { "type": "string", "enum": ["owner", "admin", "member"] },
          "state": { "type": "string", "enum": ["active", "removed"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "authRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": [
          "accountID",
          "orgID",
          "loginName",
          "displayName",
          "role",
          "state",
          "revision",
          "authRevision",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "OrgError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "AUTHENTICATION_REQUIRED",
              "PERMISSION_DENIED",
              "NOT_FOUND",
              "RUNTIME_OFFLINE",
              "COMMAND_OUTCOME_UNKNOWN",
              "REVISION_CONFLICT",
              "STALE_BINDING",
              "SHARE_REVOKED",
              "HANDOFF_BLOCKED",
              "RESOURCE_UNAVAILABLE",
              "BLOB_INCOMPLETE",
              "PROTOCOL_MISMATCH",
              "SERVICE_UNAVAILABLE",
              "ALREADY_INITIALIZED",
              "LAST_OWNER",
              "TOKEN_CONSUMED",
              "LOGIN_NAME_TAKEN"
            ]
          },
          "message": { "type": "string" },
          "requestID": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "outcome": { "type": "string", "enum": ["not_dispatched", "rejected", "unknown"] },
          "currentRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "missingRequirements": { "type": "array", "items": { "type": "string" } },
          "retryAfter": { "type": "number", "minimum": 0 }
        },
        "required": ["code", "message", "retryable", "outcome"],
        "additionalProperties": false
      },
      "OrgBootstrapInput": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requestID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "organizationName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "loginName": { "type": "string", "maxLength": 320 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
        },
        "required": ["token", "requestID", "organizationName", "loginName", "displayName", "password"],
        "additionalProperties": false
      },
      "OrgLoginResult": {
        "type": "object",
        "properties": {
          "account": { "$ref": "#/components/schemas/OrgAccount" },
          "csrfToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expiresAt": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["account", "csrfToken", "expiresAt"],
        "additionalProperties": false
      },
      "OrgLoginInput": {
        "type": "object",
        "properties": {
          "loginName": { "type": "string", "maxLength": 320 },
          "password": { "type": "string", "maxLength": 1024 }
        },
        "required": ["loginName", "password"],
        "additionalProperties": false
      },
      "OrgCurrentSession": {
        "type": "object",
        "properties": {
          "account": { "$ref": "#/components/schemas/OrgAccount" },
          "csrfToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expiresAt": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["account", "csrfToken", "expiresAt"],
        "additionalProperties": false
      },
      "OrgSuccess": {
        "type": "object",
        "properties": { "ok": { "type": "boolean", "const": true } },
        "required": ["ok"],
        "additionalProperties": false
      },
      "OrgEmptyInput": { "type": "object", "properties": {}, "additionalProperties": false },
