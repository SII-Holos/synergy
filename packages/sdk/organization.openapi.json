        "type": "object",
        "properties": { "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
        "required": ["expectedRevision"],
        "additionalProperties": false
      },
      "OrgResetConsume": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requestID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
        },
        "required": ["token", "requestID", "password"],
        "additionalProperties": false
      },
      "OrgProjectView": {
        "type": "object",
        "properties": {
          "projectID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "orgID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 },
          "state": { "type": "string", "enum": ["active", "archived"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "permissions": {
            "type": "object",
            "properties": {
              "read": { "type": "boolean" },
              "manage": { "type": "boolean" },
              "execute": { "type": "boolean" }
            },
            "required": ["read", "manage", "execute"],
            "additionalProperties": false
          },
          "role": { "type": "string", "enum": ["maintainer", "collaborator", "reader"] }
        },
        "required": ["projectID", "orgID", "name", "description", "state", "revision", "createdAt", "permissions"],
        "additionalProperties": false
      },
      "OrgProjectCreate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "default": "", "type": "string", "maxLength": 4000 }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "OrgProjectPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrgProjectView" } },
          "cursor": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "OrgProjectChange": {
        "type": "object",
        "properties": {
          "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 },
          "state": { "type": "string", "enum": ["active", "archived"] }
        },
        "required": ["expectedRevision"],
        "additionalProperties": false
      },
      "OrgProjectMemberChange": {
        "type": "object",
        "properties": {
          "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "role": {
            "anyOf": [{ "type": "string", "enum": ["maintainer", "collaborator", "reader"] }, { "type": "null" }]
          }
        },
        "required": ["expectedRevision", "role"],
        "additionalProperties": false
      },
      "OrgHealth": {
        "type": "object",
        "properties": { "ready": { "type": "boolean" }, "protocolVersion": { "type": "number", "const": 1 } },
        "required": ["ready", "protocolVersion"],
        "additionalProperties": false
      }
    }
