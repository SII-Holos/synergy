# Provenance: https://github.com/minio/minio/blob/07c3a429bfed433e49018cb0f78a52145d4bedeb/Dockerfile.release
# Provenance: https://github.com/minio/mc/blob/7394ce0dd2a80935aded936b09fa12cbb3cb8096/Dockerfile.release
# Local adaptation: build only the existing infrastructure fixture from checksum-pinned official release assets;
# retain the original server entrypoint, private credential files, client configuration and upstream licenses.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS binaries

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) minio_sha256='7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f'; mc_sha256='01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891';; \
      arm64) minio_sha256='5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d'; mc_sha256='14c8c9616cfce4636add161304353244e8de383b2e2752c0e9dad01d4c27c12c';; \
      *) echo "Unsupported MinIO fixture architecture: $TARGETARCH" >&2; exit 64;; \
    esac; \
    mkdir -p /licenses/minio /licenses/mc; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-$TARGETARCH.RELEASE.2025-09-07T16-13-09Z" -o /usr/bin/minio; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      "https://github.com/minio/mc/releases/download/RELEASE.2025-08-13T08-35-41Z/mc.linux-$TARGETARCH.RELEASE.2025-08-13T08-35-41Z" -o /usr/bin/mc; \
    printf '%s  %s\n' "$minio_sha256" /usr/bin/minio "$mc_sha256" /usr/bin/mc | sha256sum --check --strict; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/minio/minio/07c3a429bfed433e49018cb0f78a52145d4bedeb/dockerscripts/docker-entrypoint.sh -o /usr/bin/docker-entrypoint.sh; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/minio/minio/07c3a429bfed433e49018cb0f78a52145d4bedeb/LICENSE -o /licenses/minio/LICENSE; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/minio/minio/07c3a429bfed433e49018cb0f78a52145d4bedeb/CREDITS -o /licenses/minio/CREDITS; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/minio/mc/7394ce0dd2a80935aded936b09fa12cbb3cb8096/LICENSE -o /licenses/mc/LICENSE; \
    curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/minio/mc/7394ce0dd2a80935aded936b09fa12cbb3cb8096/CREDITS -o /licenses/mc/CREDITS; \
    printf '%s\n' \
      '0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0  /licenses/minio/LICENSE' \
      '113b8c63dfd987d3652950d7c2aecb1c0952b41781e79bcdac6a316418d48542  /licenses/minio/CREDITS' \
      '0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0  /licenses/mc/LICENSE' \
      '4ead58181c478e2f449d5778165684f4fceb1e7b8b3ee150051c8e7adfe4f337  /licenses/mc/CREDITS' \
      'c6a01decb5d104ef7327d0d642ce34bcc2396e600a1b7ba03568ac65b3d473be  /usr/bin/docker-entrypoint.sh' | sha256sum --check --strict; \
    chmod 0555 /usr/bin/minio /usr/bin/mc /usr/bin/docker-entrypoint.sh

FROM binaries AS minio
ENV MINIO_ACCESS_KEY_FILE=access_key \
    MINIO_SECRET_KEY_FILE=secret_key \
    MINIO_ROOT_USER_FILE=access_key \
    MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key \
    MINIO_UPDATE_MINISIGN_PUBKEY=RWTx5Zr1tiHQLwG9keckT0c45M3AGeHD6IvimQHpyRywVWGbP1aVSGav \
    MINIO_CONFIG_ENV_FILE=config.env \
    MC_CONFIG_DIR=/tmp/.mc
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
    org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z"
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio"]

FROM binaries AS mc
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
    org.opencontainers.image.revision="7394ce0dd2a80935aded936b09fa12cbb3cb8096" \
    org.opencontainers.image.version="RELEASE.2025-08-13T08-35-41Z"
ENTRYPOINT ["mc"]
CMD []
