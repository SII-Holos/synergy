{
  "name": "@ericsanchezok/synergy-external-agents",
  "version": "1.1.26",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    "./session-bridge": "./src/session-bridge.ts",
    "./agent-source": "./src/agent-source.ts",
    "./config-schema": "./src/config-schema.ts",
    ".": "./src/index.ts",
    "./component": "./src/component.ts",
    "./features": "./src/features.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun ../testing/script/test-ci.ts",
    "build": "bun ../../script/build-workspace.ts packages/external-agents",
    "test:ci": "bun ../testing/script/test-ci.ts",
    "test:coverage": "bun ../testing/script/coverage-run.ts"
  },
  "dependencies": {
    "@ericsanchezok/synergy-harness": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ericsanchezok/synergy-local-runtime": "workspace:*",
    "@ericsanchezok/synergy-testing": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "synergy": {
    "formatVersion": 1,
    "kind": "component",
    "id": "external-agents",
    "version": "1.1.26",
    "compatibility": {
      "synergy": "1.1.26"
    },
    "apiVersion": 1,
    "entry": "./dist/component.js",
    "export": "externalAgents",
    "requires": {
      "local-runtime": "1.1.26"
    },
    "features": {
      "kind": "product",
      "definitions": [
        {
          "id": "external-agents",
          "owner": "external-agents",
          "maturity": "stable",
          "activation": "restart",
          "name": "External Agents",
          "description": "Provide external agents capabilities.",
          "component": "external-agents"
        }
      ]
    }
  }
}
