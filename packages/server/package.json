{
  "name": "@ericsanchezok/synergy-server",
  "version": "1.1.26",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    "./server/server": "./src/server/server.ts",
    "./server/error": "./src/server/error.ts",
    "./server/request-body-limit": "./src/server/request-body-limit.ts",
    "./server/sse-metrics": "./src/server/sse-metrics.ts",
    "./server/config-route": "./src/server/config-route.ts",
    "./http": "./src/http.ts",
    "./server/global-nav": "./src/server/global-nav.ts",
    "./component": "./src/component.ts",
    "./server/app-static": "./src/server/app-static.ts",
    "./web-app": "./src/web-app.ts",
    "./cli/generate": "./src/cli/generate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun ../local-runtime/script/build-pty.ts && bun ../testing/script/test-ci.ts",
    "build": "bun ../../script/build-workspace.ts packages/server",
    "test:ci": "bun ../local-runtime/script/build-pty.ts && bun ../testing/script/test-ci.ts",
    "test:coverage": "bun ../local-runtime/script/build-pty.ts && bun ../testing/script/coverage-run.ts"
  },
  "dependencies": {
    "@ericsanchezok/synergy-harness": "workspace:*",
    "@ericsanchezok/synergy-local-runtime": "workspace:*",
    "@ericsanchezok/synergy-util": "workspace:*",
    "@hono/standard-validator": "0.4.0",
    "bonjour-service": "1.4.4",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "remeda": "catalog:",
    "zod": "catalog:",
    "zod-openapi": "6.0.2",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@ericsanchezok/synergy-testing": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "synergy": {
    "formatVersion": 1,
    "kind": "component",
    "id": "server",
    "version": "1.1.26",
    "compatibility": {
      "synergy": "1.1.26"
    },
    "apiVersion": 1,
    "entry": "./dist/component.js",
    "export": "server",
    "requires": {
      "local-runtime": "1.1.26"
    }
  }
}
